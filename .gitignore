# Only root/modules is build output - the DLLs get dropped in there at runtime.
# root/res is source: band plans, themes, fonts, icons. Ignoring the whole of
# root/ meant a new resource file was invisible to git status and to any normal
# commit, which silently dropped a band plan from a release build.
/root/modules/*
!/root/modules/.gitkeep
/related
/go
/android/.gradle
/xcode
*.log
__pycache__/
*.pyc

# Stray root-level generated files
/*.patch
/*.svg

# Stray Node.js files (project doesn't use Node)
package.json
package-lock.json

# Personal notes
e2e_testing_changes.md

# Android local machine config
local.properties

# Android debug keystores (sensitive)
debug*.keystore

# Gradle wrapper binary (reproducible from properties)
gradle-wrapper.jar
gradle-wrapper.properties

# Separate nested project (has own .git)
tools/

# Editor/compiler caches
.cache/
.tempdir/
